  "version": "0.1.0",
  "description": "Interactive pixel-art Christmas village where every developer's GitHub commits grow and illuminate a unique Christmas tree.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
