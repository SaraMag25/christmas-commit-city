# ==============================================================================
# Christmas Commit City - Environment Variables Example
# Copy this file to `.env` when integrating Supabase & Pix (Phases 3-7).
# Never expose private keys (such as SUPABASE_SERVICE_ROLE_KEY) in VITE_* vars.
# ==============================================================================

# Supabase public project credentials (used in frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Standardized contribution period (UTC ISO dates)
VITE_CONTRIBUTION_YEAR=2026

# Frontend (`.env` local e Cloudflare Pages — apenas variáveis públicas `VITE_*`)
VITE_PIX_KEY=your-random-pix-key-here
VITE_PIX_BR_CODE=your-pix-copy-paste-brcode-here
VITE_PIX_RECIPIENT_NAME=Your Recipient Name
VITE_PIX_RECIPIENT_CITY=Your City
VITE_PIX_GOAL_AMOUNT=5000

# Optional International USD checkout fallback URL (when Stripe Checkout Edge Function is not used)
VITE_STRIPE_CHECKOUT_URL=
VITE_KOFI_URL=
VITE_SUPPORT_USD_URL=

# ------------------------------------------------------------------------------
# Server-only Supabase Edge Function Secrets (DO NOT prefix with VITE_)
# Configure with `npx supabase secrets set KEY=value`:
#   ALLOWED_ORIGINS=https://seu-dominio.vercel.app,http://localhost:5173
#   GITHUB_TOKEN=github_pat_... (public GitHub GraphQL lookup for resolve-github-tree & sync fallback)
#   GITHUB_READONLY_TOKEN=ghp_... (legacy optional alias for GITHUB_TOKEN)
#   MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
#   MERCADOPAGO_WEBHOOK_SECRET=...
#   STRIPE_SECRET_KEY=sk_live_... (or sk_test_...)
#   STRIPE_WEBHOOK_SECRET=whsec_...
# Local-only seed script env vars (NEVER prefix with VITE_):
#   SUPABASE_SERVICE_ROLE_KEY=eyJ...
# ------------------------------------------------------------------------------
